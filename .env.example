# Market 2 Home - Environment Variables
# Copy this to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market2home
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Secret (change this in production!)
JWT_SECRET=change_this_to_a_random_secret_key_2026

# SMS (MSG91 or Fast2SMS) - leave empty for dev mode
SMS_API_KEY=
SMS_SENDER_ID=M2HOME

# Razorpay (optional for UPI payments)
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# Frontend URL (for CORS in production)
# Set this to your deployed frontend URL on Vercel/Netlify
FRONTEND_URL=http://localhost:3000

# Platform Settings (can be changed from Admin Panel)
PLATFORM_COMMISSION=10
DELIVERY_FEE=40
RIDER_PAY_PER_DELIVERY=30
ORDER_TIMEOUT_MINUTES=15
VENDOR_ORDER_TIMEOUT_MINUTES=10
